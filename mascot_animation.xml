                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Left Eye Highlight Animations -->
    <target android:name="left_highlight">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <!-- Sequence 1: Look up and hold -->
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="3000"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="translateY">
                        <keyframe android:fraction="0.0" android:value="-585.756" />
                        <keyframe android:fraction="0.15" android:value="-612.756" /> <!-- Move up -->
                        <keyframe android:fraction="0.35" android:value="-612.756" /> <!-- Hold up -->
                        <keyframe android:fraction="0.5" android:value="-585.756" />  <!-- Return to center -->
                        <keyframe android:fraction="1.0" android:value="-585.756" />  <!-- Stay centered -->
                    </propertyValuesHolder>
                </objectAnimator>

                <!-- Sequence 2: Look left and hold -->
                <objectAnimator
                    android:propertyName="translateX"
                    android:duration="3000"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="translateX">
                        <keyframe android:fraction="0.0" android:value="15.025" />
                        <keyframe android:fraction="0.5" android:value="15.025" />
                        <keyframe android:fraction="0.65" android:value="-10.025" /> <!-- Move left -->
                        <keyframe android:fraction="0.85" android:value="-10.025" /> <!-- Hold left -->
                        <keyframe android:fraction="1.0" android:value="15.025" />   <!-- Return to center -->
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>

    <!-- Right Eye Highlight Animations -->
    <target android:name="right_highlight">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="3000"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="translateY">
                        <keyframe android:fraction="0.0" android:value="-585.756" />
                        <keyframe android:fraction="0.15" android:value="-612.756" /> <!-- Move up -->
                        <keyframe android:fraction="0.35" android:value="-612.756" /> <!-- Hold up -->
                        <keyframe android:fraction="0.5" android:value="-585.756" />  <!-- Return to center -->
                        <keyframe android:fraction="1.0" android:value="-585.756" />  <!-- Stay centered -->
                    </propertyValuesHolder>
                </objectAnimator>

                <objectAnimator
                    android:propertyName="translateX"
                    android:duration="3000"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear">
                    <propertyValuesHolder android:propertyName="translateX">
                        <keyframe android:fraction="0.0" android:value="164.687" />
                        <keyframe android:fraction="0.5" android:value="164.687" />
                        <keyframe android:fraction="0.65" android:value="139.687" /> <!-- Move left -->
                        <keyframe android:fraction="0.85" android:value="139.687" /> <!-- Hold left -->
                        <keyframe android:fraction="1.0" android:value="164.687" />  <!-- Return to center -->
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>

</animated-vector>